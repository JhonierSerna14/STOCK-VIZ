{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "API para análisis y visualización de stocks",
        "title": "Stock-Viz API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/recommendations": {
            "get": {
                "description": "Retorna recomendaciones de stocks basadas en análisis",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "recommendations"
                ],
                "summary": "Obtener recomendaciones de stocks",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 6,
                        "description": "Cantidad de recomendaciones",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Fecha inicial (YYYY-MM-DD)",
                        "name": "date_from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Fecha final (YYYY-MM-DD)",
                        "name": "date_to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Tipo de rating (BUY, SELL, HOLD)",
                        "name": "rating",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Símbolo de la acción",
                        "name": "ticker",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de recomendaciones",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.StockRecommendation"
                            }
                        }
                    },
                    "500": {
                        "description": "Error al analizar stocks",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/stocks/all": {
            "get": {
                "description": "Retorna una lista paginada de todos los stocks disponibles",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stocks"
                ],
                "summary": "Obtener todos los stocks",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Número de página",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Cantidad de registros por página",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Término de búsqueda",
                        "name": "search",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de stocks con paginación",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Error al obtener stocks",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Elimina permanentemente todos los stocks de la base de datos",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stocks"
                ],
                "summary": "Eliminar todos los stocks",
                "responses": {
                    "200": {
                        "description": "Mensaje de confirmación",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Error al eliminar stocks",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.StockRecommendation": {
            "type": "object",
            "properties": {
                "analysis_rationale": {
                    "description": "Explicación del análisis",
                    "type": "string"
                },
                "company": {
                    "description": "Nombre de la empresa",
                    "type": "string"
                },
                "last_updated": {
                    "description": "Fecha de última actualización",
                    "type": "string"
                },
                "latest_rating": {
                    "description": "Última calificación asignada",
                    "type": "string"
                },
                "latest_target": {
                    "description": "Último precio objetivo",
                    "type": "string"
                },
                "score": {
                    "description": "Puntuación calculada (0-100)",
                    "type": "number"
                },
                "ticker": {
                    "description": "Símbolo de la acción",
                    "type": "string"
                }
            }
        }
    }
}